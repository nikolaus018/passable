<Window
    x:Class="PassableWin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:PassableWin.Model"
    xmlns:local="using:PassableWin"
    Title="Passable">

    <Grid x:Name="Root" Background="{StaticResource PassableBackground}" AllowDrop="True"
          DragOver="OnDragOver" Drop="OnDrop" PreviewKeyDown="OnPreviewKeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Library -->
        <Grid Grid.Column="0" Background="#0DFFFFFF" BorderBrush="{StaticResource PassableHairline}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="20,18,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Library" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="OpenButton" Click="OnOpenClick" ToolTipService.ToolTip="Add a .passablemix (Ctrl+O)"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                </Button>
            </Grid>

            <ProgressBar Grid.Row="1" x:Name="ImportBar" Visibility="Collapsed" Margin="20,0,20,8" Maximum="1" />

            <ListView Grid.Row="2" x:Name="LibraryList" SelectionMode="Single" IsItemClickEnabled="True"
                      ItemClick="OnLibraryItemClick" Padding="8,0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:MixItem">
                        <Grid Padding="4,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="8" Background="{StaticResource DeckABrush}">
                                <FontIcon Glyph="&#xE8D6;" FontSize="20" Foreground="#CC000000" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6" FontSize="12" />
                            </StackPanel>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Remove from library" Icon="Delete" Click="OnRemoveClick" Tag="{x:Bind Id}" />
                                    <MenuFlyoutItem Text="Show in Explorer" Icon="OpenLocal" Click="OnRevealClick" Tag="{x:Bind Folder}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="2" x:Name="EmptyLibrary" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Spacing="10">
                <FontIcon Glyph="&#xE8D6;" FontSize="40" Opacity="0.4" />
                <TextBlock Text="No mixes yet" FontSize="16" HorizontalAlignment="Center" />
                <TextBlock Text="Drop a .passablemix here, or choose Add. Build one in Passable on the Mac and save it with &#x201C;Save as File&#x2026;&#x201D;."
                           TextWrapping="Wrap" TextAlignment="Center" Opacity="0.6" FontSize="12" />
                <Button Content="Add a mix" Click="OnOpenClick" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <TextBlock Grid.Row="3" x:Name="LibraryFooter" Padding="20,10" Opacity="0.5" FontSize="12" />
        </Grid>

        <!-- Player -->
        <Grid Grid.Column="1" x:Name="PlayerPane" Padding="32,24,32,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar Grid.Row="0" x:Name="Notice" Severity="Error" IsOpen="False" Margin="0,0,0,12" />

            <!-- The playing song -->
            <Grid Grid.Row="1" x:Name="NowPlaying" ColumnSpacing="24" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Art" Width="140" Height="140" CornerRadius="14">
                    <TextBlock x:Name="ArtLetter" FontSize="64" FontWeight="Bold" Foreground="#99FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="MixTitle" Opacity="0.55" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SongTitle" FontSize="32" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SongArtist" FontSize="16" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Border x:Name="BpmChip" Background="{StaticResource PassableCard}" CornerRadius="6" Padding="10,3">
                            <TextBlock x:Name="BpmText" FontSize="12" />
                        </Border>
                        <Border x:Name="KeyChip" Background="{StaticResource PassableCard}" CornerRadius="6" Padding="10,3">
                            <TextBlock x:Name="KeyText" FontSize="12" />
                        </Border>
                        <Border Background="{StaticResource PassableCard}" CornerRadius="6" Padding="10,3">
                            <TextBlock x:Name="PositionText" FontSize="12" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Mixing into... -->
            <Border Grid.Row="2" x:Name="BlendStrip" Visibility="Collapsed" Margin="0,16,0,0" Padding="14,10"
                    CornerRadius="10" Background="{StaticResource PassableCard}">
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock x:Name="BlendTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="BlendStyle" HorizontalAlignment="Right" Opacity="0.65" FontSize="12" />
                    </Grid>
                    <ProgressBar x:Name="BlendBar" Maximum="1" />
                    <TextBlock x:Name="BlendNotes" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Waveform and transport -->
            <StackPanel Grid.Row="3" x:Name="Transport" Margin="0,20,0,0" Visibility="Collapsed" Spacing="6">
                <Grid x:Name="WaveHost" Height="96" Background="Transparent"
                      PointerPressed="OnWavePressed" PointerMoved="OnWaveMoved" PointerReleased="OnWaveReleased"
                      PointerCanceled="OnWaveReleased" SizeChanged="OnWaveSizeChanged">
                    <Canvas x:Name="WaveCanvas" IsHitTestVisible="False" />
                    <Rectangle x:Name="Playhead" Width="2" Fill="White" HorizontalAlignment="Left" IsHitTestVisible="False" />
                </Grid>
                <Grid>
                    <TextBlock x:Name="ElapsedText" FontSize="12" Opacity="0.7" />
                    <TextBlock x:Name="ScrubName" FontSize="12" HorizontalAlignment="Center" Opacity="0.9" />
                    <TextBlock x:Name="TotalText" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="4" x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,8,0,12" Visibility="Collapsed">
                <Button x:Name="PrevButton" Click="OnPrevClick" Width="48" Height="48" CornerRadius="24" ToolTipService.ToolTip="Previous (Ctrl+Left)">
                    <FontIcon Glyph="&#xE892;" />
                </Button>
                <Button x:Name="PlayButton" Click="OnPlayClick" Width="64" Height="64" CornerRadius="32" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Play / pause (Space)">
                    <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="24" />
                </Button>
                <Button x:Name="NextButton" Click="OnNextClick" Width="48" Height="48" CornerRadius="24" ToolTipService.ToolTip="Next (Ctrl+Right)">
                    <FontIcon Glyph="&#xE893;" />
                </Button>
            </StackPanel>

            <!-- Track list -->
            <ListView Grid.Row="5" x:Name="TrackList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnTrackClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TrackRow">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="{x:Bind Deck}" RadiusX="2" RadiusY="2" Opacity="{x:Bind BarOpacity, Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Number}" Opacity="0.55" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{x:Bind Title}" FontWeight="{x:Bind Weight, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Detail}" Opacity="0.55" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{x:Bind Length}" Opacity="0.55" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="1" Grid.RowSpan="5" x:Name="EmptyPlayer" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <TextBlock Text="Passable" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Plays the sets you build in Passable on the Mac, every transition just as rendered."
                           Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
